{
  "name": "dsa-progress-tracker",
  "version": "2.0.0",
  "description": "Full-stack DSA Progress Tracker with Node/Express backend and vanilla JS frontend",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npx live-server frontend --port=5500 --no-browser --quiet",
    "start": "npm --prefix backend start",
    "install:backend": "npm --prefix backend install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
